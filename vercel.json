{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source":"/admin","destination":"/admin/index.html"},
    {"source":"/inicio","destination":"/index.html"},
    {"source":"/eventos","destination":"/index.html"},
    {"source":"/publicaciones","destination":"/index.html"},
    {"source":"/investigacion","destination":"/index.html"},
    {"source":"/docencia","destination":"/index.html"},
    {"source":"/blog","destination":"/index.html"},
    {"source":"/galeria","destination":"/index.html"},
    {"source":"/podcast","destination":"/index.html"},
    {"source":"/contacto","destination":"/index.html"},
    {"source":"/privacidad","destination":"/index.html"},
    {"source":"/cookies","destination":"/index.html"}
  ],
  "headers": [
    {
      "source":"/(.*)",
      "headers":[
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"X-Frame-Options","value":"SAMEORIGIN"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},
        {"key":"Cross-Origin-Opener-Policy","value":"same-origin-allow-popups"},
        {"key":"Strict-Transport-Security","value":"max-age=31536000"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src 'self' https:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"}
      ]
    },
    {
      "source":"/admin",
      "headers":[
        {"key":"Cache-Control","value":"no-store"},
        {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"}
      ]
    },
    {
      "source":"/admin/(.*)",
      "headers":[
        {"key":"Cache-Control","value":"no-store"},
        {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"}
      ]
    },
    {
      "source":"/assets/js/(.*)",
      "headers":[{"key":"Cache-Control","value":"no-cache, max-age=0, must-revalidate"}]
    },
    {
      "source":"/assets/css/(.*)",
      "headers":[{"key":"Cache-Control","value":"no-cache, max-age=0, must-revalidate"}]
    },
    {
      "source":"/assets/data/(.*)",
      "headers":[{"key":"Cache-Control","value":"no-cache, max-age=0, must-revalidate"}]
    },
    {
      "source":"/assets/icons/(.*)",
      "headers":[{"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}]
    },
    {
      "source":"/service-worker.js",
      "headers":[{"key":"Cache-Control","value":"no-cache, max-age=0, must-revalidate"}]
    },
    {
      "source":"/index.html",
      "headers":[{"key":"Cache-Control","value":"no-cache, max-age=0, must-revalidate"}]
    }
  ]
}
